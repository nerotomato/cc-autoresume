{
  "name": "cc-autoresume",
  "version": "0.1.0",
  "description": "PTY wrapper for auto-pausing and resuming Claude Code when subscription quota resets.",
  "license": "MIT",
  "bin": {
    "cc-autoresume": "bin/cc-autoresume"
  },
  "files": [
    "bin",
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postinstall": "node scripts/fix-node-pty-permissions.cjs",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.6"
  }
}
